# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/club_connect"

# ── JWT (generate with: openssl rand -hex 64) ─────────────────────────────────
JWT_ACCESS_TOKEN_SECRET="REPLACE_WITH_64_CHAR_HEX_STRING"
JWT_REFRESH_TOKEN_SECRET="REPLACE_WITH_64_CHAR_HEX_STRING"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ── URLs (set to real domain in production) ───────────────────────────────────
PORT="5001"
APP_URL="https://api.yourdomain.com"
FRONTEND_URL="https://yourdomain.com"

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_FROM="Club Connect <no-reply@yourdomain.com>"
SMTP_HOST="smtp.yourdomain.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SKIP_EMAIL_VERIFICATION="false"

# ── Anthropic AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Stripe Payments ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Web Push (VAPID) — generate with: npx web-push generate-vapid-keys ───────
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# ── AWS S3 / Cloudflare R2 (file uploads) ─────────────────────────────────────
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="club-connect-uploads"
# For Cloudflare R2 only (leave blank for standard AWS S3):
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CDN_URL="https://uploads.yourdomain.com"

# ── Redis (required for multi-instance Socket.io) ─────────────────────────────
REDIS_URL="rediss://default:password@your-redis-host:6379"

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV="production"
LOG_LEVEL="info"
