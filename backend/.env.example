# ── Recommended free-tier stack (see the deploy checklist for signup links) ───
# Frontend: Vercel · Backend: Render · Database: Neon · Uploads: Cloudflare R2
# Email: Resend · Redis (optional): Upstash · AI: Anthropic · Payments: SSLCommerz

# ── Database — Neon (console.neon.tech), free forever, no card required ──────
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/club_connect?sslmode=require"

# ── JWT (generate with: openssl rand -hex 64) ─────────────────────────────────
JWT_ACCESS_TOKEN_SECRET="REPLACE_WITH_64_CHAR_HEX_STRING"
JWT_REFRESH_TOKEN_SECRET="REPLACE_WITH_64_CHAR_HEX_STRING"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ── URLs (set to your real Render backend URL and Vercel frontend URL) ────────
PORT="5001"
APP_URL="https://your-service.onrender.com"
FRONTEND_URL="https://your-project.vercel.app"

# ── Email (SMTP) — Resend (resend.com/overview), 100/day, 3000/mo free ────────
# Resend's SMTP relay always uses these exact host/user — only the password changes.
EMAIL_FROM="Club Connect <no-reply@yourdomain.com>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="REPLACE_WITH_YOUR_RESEND_API_KEY"
SKIP_EMAIL_VERIFICATION="false"

# ── Anthropic AI (console.anthropic.com) — pay-as-you-go, Haiku calls are cheap
ANTHROPIC_API_KEY="sk-ant-..."

# ── SSLCommerz Payments (developer.sslcommerz.com) — Bangladesh gateway,
# bundles bKash/Nagad/Rocket/cards. Sandbox demo creds work with no signup:
# store_id "testbox", store_passwd "qwerty", SSLCOMMERZ_IS_LIVE "false".
# Real store credentials: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID="testbox"
SSLCOMMERZ_STORE_PASSWORD="qwerty"
SSLCOMMERZ_IS_LIVE="false"

# ── Web Push (VAPID) — generate with: npx web-push generate-vapid-keys ───────
# Generate a fresh pair per environment — don't reuse your local dev keys in prod.
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# ── Google OAuth (console.cloud.google.com/apis/credentials) — free ───────────
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# ── File uploads — Cloudflare R2 (dash.cloudflare.com), 10GB free forever ─────
# R2 is S3-compatible: same client code, just point S3_ENDPOINT at your account.
AWS_ACCESS_KEY_ID="your-r2-access-key-id"
AWS_SECRET_ACCESS_KEY="your-r2-secret-access-key"
AWS_REGION="auto"
AWS_S3_BUCKET="club-connect-uploads"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CDN_URL=""

# ── Redis — Upstash (console.upstash.com), 256MB free forever ────────────────
# Optional: only matters once you run more than one backend instance. A single
# Render service works fine with this left blank — the app skips it gracefully.
REDIS_URL=""

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV="production"
LOG_LEVEL="info"
